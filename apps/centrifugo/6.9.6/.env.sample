CONTAINER_NAME=centrifugo
PANEL_APP_PORT_HTTP=8000
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=replace-with-a-random-hmac-secret
CENTRIFUGO_HTTP_API_KEY=replace-with-a-random-api-key
CENTRIFUGO_ADMIN_ENABLED=true
CENTRIFUGO_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CENTRIFUGO_ADMIN_SECRET=replace-with-a-random-session-secret
CENTRIFUGO_CHANNEL_WITHOUT_NAMESPACE_ALLOW_SUBSCRIBE_FOR_CLIENT=true
CENTRIFUGO_LOG_LEVEL=info
